# Скопировать на сервере в .env (cp .env.prod.example .env) и заполнить. В git не коммитить.

# Адрес для https: IP сервера (сертификат Let's Encrypt на IP) или домен, если появится
DENTAL_DOMAIN=164.92.189.88

# Пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=

# Токен от @BotFather (новый, после /revoke)
TELEGRAM_BOT_TOKEN=
# Секрет webhook: openssl rand -hex 32 (Telegram принимает буквы, цифры, _ и -)
TELEGRAM_WEBHOOK_SECRET=

# Telegram id врача; несколько — через запятую
ALLOWED_TELEGRAM_IDS=496356486
# Ответ посторонним: как записаться
CLINIC_CONTACT=

# Рабочие часы и дни врача (по Бишкеку): «09:00-18:00», «MON-SAT» или «MON,WED,FRI»
WORK_HOURS=09:00-18:00
WORK_DAYS=MON-SUN

# Подпись в конце напоминания в WhatsApp, например: Стоматология «Улыбка», 0555 000 000
CLINIC_SIGNATURE=

# Уведомления врачу в Telegram (по Бишкеку); NOTIFY_BEFORE_MINUTES=0 — не предупреждать перед приёмом
MORNING_DIGEST_TIME=09:00
EVENING_DIGEST_TIME=18:30
NOTIFY_BEFORE_MINUTES=15
# Бот сам напоминает о завтрашнем приёме записавшимся через бота; false — не напоминать
PATIENT_REMINDER_TIME=18:00
AUTO_REMIND_PATIENTS=true
# На следующий день после приёма бот спрашивает оценку 1–5; false — не спрашивать
REVIEW_TIME=12:00
ASK_REVIEWS=true

# Самозапись пациентов через бота; false — посторонние видят только CLINIC_CONTACT
PATIENT_BOOKING=true
